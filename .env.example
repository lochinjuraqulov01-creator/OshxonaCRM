# ============================================================
#  SmartOshxona — Oshxona avtomatlashtirish tizimi
#  Environment o'zgaruvchilari (namuna)
#  Nusxalab .env nomi bilan saqlang:  cp .env.example .env
# ============================================================

# ---------- Django ----------
SECRET_KEY=changeme-generatsiya-qiling-masalan-python-manage.py-shell
DEBUG=True
ALLOWED_HOSTS=*

# Ma'lumotlar bazasi: postgres (prod) yoki sqlite (tez lokal demo)
DB_ENGINE=postgres
DB_NAME=smart_oshxona
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---------- Redis (kesh + WebSocket channel layer) ----------
# Redis o'rnatilmagan bo'lsa USE_REDIS=False qiling (lokal demo rejimi)
USE_REDIS=True
REDIS_URL=redis://localhost:6379/0

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...  (BotFather dan olingan token)
TELEGRAM_ADMIN_CHAT_ID=               (ogohlantirishlar uchun, ixtiyoriy)

# Mini App manzili (HTTPS bo'lishi SHART — Telegram talabi)
#
# ── NGROK bilan (lokal test uchun) ─────────────────────────────
# 1) Django portini ngrok'ga ulang (port 8000 — manage.py runserver porti):
#       ngrok http 8000
# 2) Ngrok bergan https manzilini PASTGA yozing (oxirida /miniapp/ bilan):
#       MINI_APP_URL=https://scyphiform-lakisha-fungivorous.ngrok-free.dev/miniapp/
# 3) Admin panel uchun ham XUDI shu manzil, faqat /adminpanel/ bilan:
#       ADMIN_PANEL_URL=https://scyphiform-lakisha-fungivorous.ngrok-free.dev/adminpanel/
#    → Ya'ni IKKALA o'zgaruvchiga bitta ngrok domenidan foydalanish mumkin ✓
# 4) BotFather → /setmenubutton → URL sifatida MINI_APP_URL ni kiriting
#    (yoki bot «Menyu» tugmasi WebApp URL sifatida shu manzilni oladi)
# ⚠️  Ngrok bepul versiyada har qayta ishga tushirganda domaen O'ZGARADI —
#     .env ni yangilab, botni qayta ishga tushirish kerak bo'ladi.
#     Kengaytma/chegaralangan versiyada statik domaen olinadi.
#
# ── Doimiy domaen (prod) ───────────────────────────────────────
# MINI_APP_URL=https://your-domain.uz/miniapp/
# ADMIN_PANEL_URL=https://your-domain.uz/adminpanel/
MINI_APP_URL=https://your-domain.uz/miniapp/
ADMIN_PANEL_URL=https://your-domain.uz/adminpanel/

# ---------- Xavfsizlik ----------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
